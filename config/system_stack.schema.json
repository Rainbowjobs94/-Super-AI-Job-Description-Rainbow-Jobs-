{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AISystemTools",
  "type": "object",
  "required": ["system", "layers"],
  "properties": {
    "system": {
      "type": "object",
      "required": ["name", "owner", "description"],
      "properties": {
        "name": {"type": "string"},
        "owner": {"type": "string"},
        "description": {"type": "string"}
      },
      "additionalProperties": false
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "tools"],
        "properties": {
          "name": {"type": "string"},
          "description": {"type": "string"},
          "tools": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "type", "description", "tags"],
              "properties": {
                "id": {"type": "string"},
                "type": {"type": "string"},
                "description": {"type": "string"},
                "tags": {
                  "type": "array",
                  "items": {"type": "string"}
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
